# Required in production for secure OTP/session cookies (min 16 characters)
AUTH_SECRET=generate-a-long-random-string-here

# When SMS_PROVIDER is set (e.g. twilio), OTP codes are hidden from the UI.
# SMS_PROVIDER=twilio

# Set to "false" to hide demo OTP codes even without SMS (not recommended for MVP)
# EXPOSE_DEV_OTP=false
